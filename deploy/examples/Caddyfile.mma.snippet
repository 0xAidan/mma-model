# EXAMPLE ONLY — NOT INSTALLED (DWCS-004 / updated for DWCS-503 notes)
# Merge this as an additional site block into the EXISTING host Caddyfile.
# Do not start a second reverse proxy. Existing host Caddy keeps public HTTP/HTTPS.
#
# Production host runs Caddy 2.6.2 → use basicauth (not basic_auth / Caddy 2.8+).
# Production snippet with cache + CSP: deploy/Caddyfile.mma

mma.shermandavison.com {
	# Generate with: caddy hash-password
	# Commit only placeholders — never a live hash or plaintext password.
	basicauth {
		mma_dashboard REDACTED_HASH_PLACEHOLDER
	}

	root * /srv/mma/public
	encode gzip zstd
	file_server

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# Production CSP lives in deploy/Caddyfile.mma
	}

	log {
		output stdout
	}
}
