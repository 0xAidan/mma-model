# EXAMPLE ONLY — NOT INSTALLED (DWCS-504)
# Host-only monitoring env template.
# Copy to /etc/mma-model/monitoring.env with ownership root:root mode 0600.
# NEVER commit real Healthchecks write URLs (they contain secret UUIDs).

# Scheduler tick heartbeats (start/success/fail)
# Example shape only — replace on the host:
MMA_HC_SCHEDULER_URL=https://hc-ping.com/PLACEHOLDER_SCHEDULER_UUID

# Nightly backup heartbeats
MMA_HC_BACKUP_URL=https://hc-ping.com/PLACEHOLDER_BACKUP_UUID

# Host monitor rollup (disk, backup age, TLS, dashboard HTTPS, health.json)
MMA_HC_MONITOR_URL=https://hc-ping.com/PLACEHOLDER_MONITOR_UUID

# Optional thresholds (defaults match the plan)
# MMA_DISK_ALERT_PCT=80
# MMA_BACKUP_MAX_AGE_HOURS=26
# MMA_JOB_TIMEOUT_SEC=1500

# External HTTPS uptime monitors (UptimeRobot / Better Stack / etc.) are
# configured in their SaaS UI — not as secrets in this file. See
# docs/runbooks/monitoring.md.
