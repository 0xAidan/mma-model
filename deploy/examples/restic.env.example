# EXAMPLE ONLY — NOT INSTALLED (DWCS-505)
# Copy to /etc/mma-model/restic.env with ownership root:root mode 0600.
# NEVER commit a real RESTIC_PASSWORD or cloud credentials.

# Local proof repository (CI / first host drill). Separate failure domain
# for production: point this at Backblaze B2, S3-compatible storage, or
# another VPS path — see docs/runbooks/backup-restore.md.
RESTIC_REPOSITORY=/var/lib/mma-model/restic-repo

# Prefer a password file on the host (mode 0600) over an inline password.
# RESTIC_PASSWORD_FILE=/etc/mma-model/restic.password
RESTIC_PASSWORD=PLACEHOLDER_CHANGE_ME

# Optional AWS/B2 style keys when RESTIC_REPOSITORY uses s3: or b2:
# AWS_ACCESS_KEY_ID=PLACEHOLDER
# AWS_SECRET_ACCESS_KEY=PLACEHOLDER
# B2_ACCOUNT_ID=PLACEHOLDER
# B2_ACCOUNT_KEY=PLACEHOLDER
