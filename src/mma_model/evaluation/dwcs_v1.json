{
  "schema_version": 1,
  "contract_id": "dwcs_evaluation",
  "contract_version": "1.0.1",
  "description": "Frozen DWCS evaluation contract (DWCS-001). Normal model runs must not mutate this file. Content changes require an explicit contract_version and PINNED_CONTRACT_HASH update.",
  "universe": {
    "series": "dwcs",
    "seasons": {
      "first": 2017,
      "last": 2025
    },
    "all_dwcs": {
      "cards": 89,
      "bouts": 440
    },
    "standard_only": {
      "cards": 86,
      "bouts": 425
    },
    "brazil": {
      "cards": 3,
      "bouts": 15,
      "series_variant": "dwcs_brazil",
      "year": 2018
    }
  },
  "splits": {
    "grouping": "event_card",
    "outer_fold": "rolling_origin_one_card_at_a_time",
    "target_cards": 89,
    "development": {
      "seasons": [2017, 2018, 2019, 2020, 2021, 2022, 2023],
      "locked": false
    },
    "validation": {
      "seasons": [2024],
      "locked": false
    },
    "holdout": {
      "seasons": [2025],
      "locked": true
    }
  },
  "point_in_time": {
    "prediction_cutoff_minutes_before_scheduled_start": 60,
    "identical_cutoff_per_card": true,
    "mutable_fact_rules": {
      "effective_at_strictly_before_cutoff": true,
      "observed_at_at_or_before_cutoff": true
    },
    "forbid_same_card_results": true,
    "forbid_later_corrections_before_adjudication": true,
    "forbid_current_fighter_aggregates": true,
    "forbid_post_cutoff_odds_snapshots": true,
    "proxy_scheduled_start_excludes_exact_closing_line_analysis": true
  },
  "sensitivity": {
    "report_universes": ["all_dwcs", "standard_only"]
  },
  "labels": {
    "terminal_atoms": [
      "a_ko_tko",
      "a_submission",
      "a_other_stoppage",
      "a_decision",
      "b_ko_tko",
      "b_submission",
      "b_other_stoppage",
      "b_decision",
      "draw"
    ],
    "settlement_only_excluded_from_win_fitting": ["no_contest", "void"],
    "half_round_intervals_for_three_round_bout": 6,
    "baselines": {
      "M0": ["fifty_fifty", "sequential_rating", "no_vig_market"],
      "M1": "ridge_logistic_moneyline"
    }
  },
  "metrics": {
    "outcome": [
      "joint_log_loss",
      "market_log_loss",
      "brier",
      "calibration_intercept",
      "calibration_slope",
      "reliability_bins",
      "ece",
      "accuracy_descriptive_only",
      "skill_vs_each_baseline"
    ],
    "betting_priced_only": [
      "qualifying_bets",
      "turnover",
      "flat_1_unit_roi",
      "quarter_kelly_roi_capped_at_1_percent_bankroll",
      "clv",
      "maximum_drawdown",
      "longest_losing_run",
      "by_market_splits",
      "by_season_splits"
    ],
    "selection": ["availability", "abstention_rate"],
    "priced_rows_require": "timestamped_observed_or_user_recorded_price",
    "price_target_rows_never_receive_synthetic_betting_performance": true
  },
  "confidence_intervals": {
    "bootstrap_refits": 200,
    "bootstrap_unit": "event_block",
    "probability_and_ev": {
      "bootstrap_unit": "event_block",
      "interval_levels": [0.9, 0.95]
    },
    "betting_metrics": {
      "bootstrap_unit": "event_block",
      "interval_levels": [0.9, 0.95],
      "note": "Betting ROI/CLV/drawdown intervals use event-block bootstrap at 90% and 95%; never fight-iid resampling."
    }
  },
  "recommendation": {
    "max_confirmed_value_markets_per_matchup": 1,
    "rank_confirmed_by": "highest_p25_ev",
    "emit_no_bet_when_gates_fail": true,
    "fair_decimal_odds": "1 / p50",
    "actionable_ev_target": 0.05,
    "strong_value_ev_target": 0.1,
    "actionable_decimal_price": "max(1 / p25, 1.05 / p50)",
    "strong_value_decimal_price": "max(1 / p25, 1.10 / p50)",
    "confirmed_value_min_prob_ev_positive": 0.7,
    "exact_round_actionable_ev_target": 0.1,
    "exact_round_min_prob_ev_positive": 0.75,
    "classifications": ["confirmed_value", "price_target", "no_bet"],
    "unpriced_target_is_not_best_available_market": true,
    "american_odds_renderer_expresses_or_better": true
  },
  "price_policy": {
    "bookmaker_odds_optional_enrichment": true,
    "missing_bet365_does_not_block_core_guidance": true,
    "sportsbook_agnostic_fair_actionable_strong_value_required": true,
    "exact_ev_roi_clv_require_timestamped_price": true,
    "price_target_only_rows_never_receive_synthetic_betting_performance": true
  },
  "go_live_gates": {
    "data": {
      "target_cards": 89,
      "target_bouts": 440,
      "min_cross_source_reconciliation": 0.98,
      "min_result_agreement": 0.99,
      "max_unresolved_identity_conflicts": 0,
      "max_leakage_invariant_failures": 0
    },
    "moneyline": {
      "max_unexplained_feature_exclusion_rate_decisive": 0.02,
      "holdout_2025_delta_log_loss_vs_m1_must_be_non_positive": true,
      "holdout_2025_event_block_90pct_ucb_delta_log_loss": {
        "strict_upper_bound": 0.02,
        "comparison": "lt",
        "meaning": "Pass only when the event-block 90% upper confidence bound on delta log loss versus M1 is strictly below +0.02 (ucb < 0.02), not <=."
      },
      "odds_backed_2020_plus_max_worse_than_no_vig_log_loss": 0.01,
      "odds_backed_2020_plus_positive_skill_vs_data_only_baseline": true,
      "calibration_slope_min": 0.8,
      "calibration_slope_max": 1.2,
      "calibration_intercept_min": -0.1,
      "calibration_intercept_max": 0.1,
      "ece_max": 0.08,
      "min_qualifying_historical_priced_bets": 50,
      "positive_mean_same_book_clv": true,
      "clv_90pct_lower_bound_at_or_above_zero": true,
      "positive_flat_stake_roi": true,
      "max_simulated_bankroll_drawdown_quarter_kelly": 0.25,
      "consecutive_live_paper_cards": 3
    },
    "market_families": {
      "totals_inside_distance_min_priced_oos": 100,
      "method_min_priced_oos": 150,
      "exact_round_min_priced_oos": 200,
      "exact_round_min_realized_per_active_bucket": 25,
      "failed_family_status": "experimental",
      "failed_family_may_not_emit_confirmed_value_or_price_target": true
    }
  }
}
